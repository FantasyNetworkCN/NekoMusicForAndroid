<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/transparent">

    <LinearLayout
        android:id="@+id/desktop_lyric_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/desktop_lyric_lock"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/desktop_lyric_control_background"
            android:contentDescription="@string/desktop_lyric_lock"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_desktop_lyric_unlock" />

        <ImageButton
            android:id="@+id/desktop_lyric_previous"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/desktop_lyric_control_background"
            android:contentDescription="@string/desktop_lyric_previous"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_desktop_lyric_previous" />

        <ImageButton
            android:id="@+id/desktop_lyric_play_pause"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/desktop_lyric_control_background"
            android:contentDescription="@string/desktop_lyric_play"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_desktop_lyric_play" />

        <ImageButton
            android:id="@+id/desktop_lyric_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/desktop_lyric_control_background"
            android:contentDescription="@string/desktop_lyric_next"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_desktop_lyric_next" />

        <ImageButton
            android:id="@+id/desktop_lyric_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:background="@drawable/desktop_lyric_control_background"
            android:contentDescription="@string/desktop_lyric_close"
            android:padding="9dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_desktop_lyric_close" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/desktop_lyric_text_scroll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipToPadding="false"
                android:enabled="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.neko.music.desktoplyric.DesktopLyricKaraokeTextView
                    android:id="@+id/desktop_lyric_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:shadowColor="@android:color/black"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="3"
                    android:singleLine="true"
                    android:text="@string/no_lyrics"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/desktop_lyric_romanization"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="3dp"
                android:shadowColor="@android:color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:text=""
                android:textColor="#D8D8E8"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/desktop_lyric_translation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:shadowColor="@android:color/black"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="3"
                android:text=""
                android:textColor="#CCCCCC"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/desktop_lyric_lock_badge"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="6dp"
            android:alpha="0.8"
            android:contentDescription="@string/desktop_lyric_locked"
            android:src="@drawable/ic_desktop_lyric_lock"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
